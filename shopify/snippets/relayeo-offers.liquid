{%- comment -%}
  Relayeo Autonomous AI Commerce — Multi-Variant Schema Patch
  Repository: https://github.com/reachmeghanashyam-coder/relayeo-public
  Canonical Research: https://www.relayeo.com/research/shopify-agentic-holiday-season-variant-drop
  
  Purpose:
  Emits server-rendered W3C Schema.org Offer nodes for all active variants.
  Resolves the 68.2% AI variant drop rate in ChatGPT Search, Perplexity Sonar,
  and autonomous shopping crawlers (OAI-SearchBot).
{%- endcomment -%}

"offers": [
  {%- for variant in product.variants -%}
  {
    "@type": "Offer",
    "name": {{ variant.title | json }},
    "sku": {{ variant.sku | json }},
    "price": {{ variant.price | divided_by: 100.00 | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "url": "{{ shop.url }}{{ variant.url }}",
    "itemCondition": "https://schema.org/NewCondition"
  }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]
